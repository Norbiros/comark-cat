{
  "name": "comark-cat",
  "version": "0.1.0",
  "description": "Simply render Markdown in your terminal with Comark.",
  "keywords": [
    "cli",
    "comark",
    "markdown",
    "terminal"
  ],
  "homepage": "https://github.com/Norbiros/comark-cat#readme",
  "bugs": {
    "url": "https://github.com/Norbiros/comark-cat/issues"
  },
  "license": "MIT",
  "author": "Norbiros <norbiros@protonmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Norbiros/comark-cat.git"
  },
  "bin": {
    "cmk": "./dist/comark-cat.mjs",
    "comark-cat": "./dist/comark-cat.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepack": "vp pack"
  },
  "devDependencies": {
    "@comark/ansi": "0.6.2",
    "@types/node": "catalog:types",
    "beautiful-mermaid": "1.1.3",
    "citty": "0.2.2",
    "katex": "0.18.1",
    "publint": "catalog:build",
    "rangi": "2.2.0",
    "supports-hyperlinks": "4.5.0",
    "typescript": "catalog:build",
    "unplugin-unused": "catalog:build",
    "vite": "catalog:vite",
    "vite-plus": "catalog:vite"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0"
}
